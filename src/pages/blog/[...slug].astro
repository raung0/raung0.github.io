---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getDescription, isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(isPublished);

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, description: getDescription(entry) },
  }));
}

interface RouteProps {
  entry: CollectionEntry<"blog">;
  description: string;
}

const { entry, description } = Astro.props as RouteProps;
const { Content } = await render(entry);
---

<BlogPost {...entry.data} {description}><Content /></BlogPost>
