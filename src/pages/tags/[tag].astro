---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(isPublished)
    .sort((b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`Posts tagged ${tag}`} description={`Posts tagged ${tag}.`}>
  <h3>Filtering for "{tag}"</h3>
  <a href="/blog/">Remove filter</a>
  <PostList {posts} showTags={false} />
</Base>
