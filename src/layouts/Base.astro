---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import { SITE_LANG } from "../consts";

interface Props {
  title?: string;
  description?: string;
  type?: "article" | "website";
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, type, publishedTime, modifiedTime } = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead {title} {description} lang={SITE_LANG} {type} {publishedTime} {modifiedTime} />
  </head>
  <body>
    <Header><Nav /></Header>
    <main><slot /></main>
    <Footer />
  </body>
</html>
