---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { getPostUrl, tagPath } from "../lib/content";

interface Props {
  posts: CollectionEntry<"blog">[];
  showTags?: boolean;
}

const { posts, showTags = true } = Astro.props;
const tags = [
  ...new Set(posts.flatMap((post) => post.data.tags)),
].sort((a, b) => a.localeCompare(b));
---

{posts.length ? (
  <>
    <ul class="blog-posts">
      {posts.map((post) => (
        <li>
          <span><FormattedDate date={post.data.pubDate} /></span>
          <a href={getPostUrl(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    {showTags && tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <a class="tag" href={tagPath(tag)} rel="nofollow">#{tag}</a>)}
      </div>
    )}
  </>
) : (
  <p>No posts yet.</p>
)}
